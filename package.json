{
  "name": "thesis-coordinator",
  "version": "0.1.0",
  "private": true,
  "description": "Bachelor thesis supervision and defense management",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.12.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests tests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "export:docs": "python3 scripts/export/export-docs.py",
    "export:docs:pdf": "python3 scripts/export/export-docs-pdf.py",
    "export:code": "python3 scripts/export/export-code.py",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.0",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "minio": "^8.0.5",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^7.0.3",
    "pg": "^8.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.52.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.25.1",
    "eslint-config-next": "^16.4.4",
    "prettier": "^3.5.3",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
