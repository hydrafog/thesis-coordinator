datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  COORDINATOR
  COMMITTEE_MEMBER
  COMMITTEE_PRESIDENT
  ADMINISTRATOR
  SECRETARY
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ThesisStatus {
  PROPOSED
  IN_PROGRESS
  SUBMITTED
  DEFENDED
  ARCHIVED
}

enum ProposalState {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum MilestoneState {
  PENDING
  COMPLETED
}

enum ReviewDecision {
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum SimilarityState {
  PENDING
  COMPLETED
  FAILED
}

enum DossierState {
  DRAFT
  SUBMITTED
  VERIFIED
  RETURNED
}

enum DossierItemType {
  FINAL_THESIS
  COORDINATOR_REPORT
  SIMILARITY_REPORT
  APPROVAL_RECORD
  INSTITUTIONAL_DOC
}

enum ItemStatus {
  PENDING
  COMPLETE
}

enum SlotStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CommitteeMemberRole {
  PRESIDENT
  MEMBER
}

enum GradingState {
  OPEN
  CLOSED
  ARCHIVED
}

enum MinutesStatus {
  DRAFT
  FINALIZED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String        @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  accounts       Account[]
  sessions       Session[]
  roles          RoleAssignment[]
  studentProfile StudentProfile?
  coordinatorProfile CoordinatorProfile?
  committeeMembers CommitteeMember[]
  sentMessages   Message[]
  conversationParticipants ConversationParticipant[]
  auditEvents    AuditEvent[]   @relation("ActorAuditEvents")
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  role      UserRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model StudentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  studyGroup String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theses Thesis[]
}

model CoordinatorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  researchAreas String
  quota         Int      @default(6)
  acceptedCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theses Thesis[]
}

model Thesis {
  id            String       @id @default(cuid())
  studentId     String
  coordinatorId String?
  title         String
  description   String?
  status        ThesisStatus @default(PROPOSED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  student            StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  coordinator        CoordinatorProfile? @relation(fields: [coordinatorId], references: [id], onDelete: SetNull)
  proposals          Proposal[]
  milestones         Milestone[]
  submissions        Submission[]
  defenseFile        DefenseFile?
  defenseSlot        DefenseSlot?
  conversations      Conversation[]

  @@index([studentId])
  @@index([coordinatorId])
}

model Proposal {
  id           String        @id @default(cuid())
  thesisId     String
  title        String
  description  String?
  objectives   String?
  technologies String?
  state        ProposalState @default(DRAFT)
  revision     Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  thesis     Thesis      @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@unique([thesisId, revision])
  @@index([thesisId])
}

model Milestone {
  id          String         @id @default(cuid())
  thesisId    String
  proposalId  String?
  title       String
  description String?
  dueAt       DateTime
  completedAt DateTime?
  state       MilestoneState @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  thesis   Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([thesisId])
}

model Submission {
  id        String    @id @default(cuid())
  thesisId  String
  title     String
  notes     String?
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  thesis           Thesis            @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  fileVersions     FileVersion[]
  reviews          Review[]
  similarityReport SimilarityReport?

  @@index([thesisId])
}

model FileVersion {
  id           String   @id @default(cuid())
  submissionId String
  version      Int
  fileName     String
  fileKey      String
  fileSize     Int
  mimeType     String
  checksum     String
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, version])
  @@index([submissionId])
}

model Review {
  id           String         @id @default(cuid())
  submissionId String
  authorId     String
  decision     ReviewDecision
  comments     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model SimilarityReport {
  id           String          @id @default(cuid())
  submissionId String          @unique
  score        Float
  state        SimilarityState @default(PENDING)
  reportKey    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model DefenseFile {
  id         String       @id @default(cuid())
  thesisId   String       @unique
  state      DossierState @default(DRAFT)
  feedback   String?
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  thesis Thesis            @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  items  DefenseFileItem[]
}

model DefenseFileItem {
  id            String          @id @default(cuid())
  defenseFileId String
  type          DossierItemType
  name          String
  fileKey       String?
  status        ItemStatus      @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  defenseFile DefenseFile @relation(fields: [defenseFileId], references: [id], onDelete: Cascade)

  @@unique([defenseFileId, type])
  @@index([defenseFileId])
}

model Committee {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      CommitteeMember[]
  defenseSlots DefenseSlot[]
}

model CommitteeMember {
  id          String              @id @default(cuid())
  committeeId String
  userId      String
  role        CommitteeMemberRole @default(MEMBER)
  createdAt   DateTime            @default(now())

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([committeeId, userId])
  @@index([committeeId])
  @@index([userId])
}

model DefenseSlot {
  id              String     @id @default(cuid())
  thesisId        String?    @unique
  committeeId     String?
  date            DateTime
  startTime       String
  endTime         String
  durationMinutes Int        @default(20)
  room            String
  status          SlotStatus @default(DRAFT)
  order           Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  thesis         Thesis?         @relation(fields: [thesisId], references: [id], onDelete: SetNull)
  committee      Committee?      @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  gradingSession GradingSession?

  @@index([committeeId, date])
}

model GradingSession {
  id            String       @id @default(cuid())
  defenseSlotId String       @unique
  state         GradingState @default(OPEN)
  finalAverage  Float?
  closedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  defenseSlot DefenseSlot     @relation(fields: [defenseSlotId], references: [id], onDelete: Cascade)
  grades      Grade[]
  minutes     DefenseMinutes?
}

model Grade {
  id               String   @id @default(cuid())
  gradingSessionId String
  memberId         String
  criterion        String   @default("general")
  value            Float
  weight           Float    @default(1.0)
  comments         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  gradingSession GradingSession @relation(fields: [gradingSessionId], references: [id], onDelete: Cascade)

  @@unique([gradingSessionId, memberId, criterion])
  @@index([gradingSessionId])
}

model DefenseMinutes {
  id               String        @id @default(cuid())
  gradingSessionId String        @unique
  pdfKey           String
  checksum         String
  status           MinutesStatus @default(FINALIZED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  gradingSession GradingSession @relation(fields: [gradingSessionId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  thesisId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thesis       Thesis?                   @relation(fields: [thesisId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([thesisId])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments  Attachment[]

  @@index([conversationId])
  @@index([senderId])
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String
  fileKey   String
  fileName  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetId, createdAt])
  @@index([actorId])
}

